# Caddy behind a Cloudflare Tunnel. TLS ends at Cloudflare's edge and the
# tunnel is encrypted; cloudflared, in the stack's private network, is the
# only client, so its Cf-Connecting-Ip header is the visitor's address.
# Caddy hands that to the API and dashboard as X-Forwarded-For (the only
# proxy header they believe, and only from the private network).
#
# No access log: requests aren't recorded (see docs/DATABASE.md, No-logs).

{
	admin off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

http://{$APP_DOMAIN} {
	import common
	reverse_proxy web:3000 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
	}
}

http://{$API_DOMAIN} {
	import common
	reverse_proxy api:8787 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
	}
}

# Any other name: nothing here.
:80 {
	respond 404
}
