# Stack settings (docker compose --env-file stack.env). Keep this file 0600.

# Public names (both proxied by Cloudflare; the tunnel's public hostnames
# point at http://caddy:80).
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token.
TUNNEL_TOKEN=

# Which images to run: local/…:dev are built here (up --build); a release
# built by CI is APEXY_REGISTRY=ghcr.io/<github owner> APEXY_VERSION=v1.0.0.
APEXY_REGISTRY=local
APEXY_VERSION=dev
