# The account API in production. Keep this file 0600; never commit it.
# docs/PRODUCTION.md explains each group.

NODE_ENV=production
PUBLIC_BASE_URL=https://api.example.com
WEB_APP_URL=https://app.example.com
# Caddy and the dashboard reach the API over the stack's private network.
TRUST_PROXY=loopback,uniquelocal

# Supabase session pooler (port 5432), certificate-checked.
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-ca.crt

# 32 random bytes each, base64: openssl rand -base64 32
ACCESS_TOKEN_SEED=
RELAY_SIGNING_SEED=
RELAY_KEY_ID=fleet-1
DATA_ENCRYPTION_KEY=

NODE_PROVISIONING=agent

# Any SMTP provider (Postmark, SES, Mailgun, Brevo, Resend…).
MAIL_TRANSPORT=smtp
SMTP_URL=smtps://<user>:<password>@smtp.example.com:465
MAIL_FROM=Apexy VPN <no-reply@example.com>

# Stripe: live keys in production (STRIPE_MODE=test only on staging).
BILLING_PROVIDER=stripe
STRIPE_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Staff tools need two-step verification (the default in production).
# ADMIN_REQUIRE_MFA=true
