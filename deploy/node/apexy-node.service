# /etc/systemd/system/apexy-node.service
[Unit]
Description=Apexy VPN node agent (WireGuard peer sync)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
# Restarted with WireGuard, stopped with it.
BindsTo=wg-quick@wg0.service

[Service]
Type=exec
# APEXY_NODE_API=https://api.example.com
EnvironmentFile=/etc/apexy/node.env
# The token file stays root-only; systemd hands the agent a private copy.
LoadCredential=node-token:/etc/apexy/node-token
ExecStart=/usr/local/bin/apexy-node --interface wg0
Restart=always
RestartSec=2

# Runs as a throwaway user whose only privilege is managing network
# interfaces (for `wg set`).
DynamicUser=yes
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
