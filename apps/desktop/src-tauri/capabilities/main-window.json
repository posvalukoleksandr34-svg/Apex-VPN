{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window: listen to the core's events and call the app's own commands. No plugin is reachable from the WebView directly; the Rust core uses them on its behalf and validates every input.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-service-request",
    "allow-service-status",
    "allow-service-reconnect",
    "allow-account-session",
    "allow-account-register",
    "allow-account-verify-email",
    "allow-account-resend-verification",
    "allow-account-login",
    "allow-account-login-mfa",
    "allow-account-logout",
    "allow-account-forgot-password",
    "allow-account-reset-password",
    "allow-account-request",
    "allow-account-enroll-device",
    "allow-support-create-ticket",
    "allow-app-info",
    "allow-app-installed-apps",
    "allow-app-notify",
    "allow-app-get-autostart",
    "allow-app-set-autostart",
    "allow-app-open-external",
    "allow-app-save-text-file",
    "allow-app-pick-files",
    "allow-app-set-tray",
    "allow-app-set-close-to-tray",
    "allow-app-hide-window",
    "allow-app-quit",
    "allow-app-set-global-shortcut"
  ]
}
