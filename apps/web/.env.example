# The web dashboard's settings. In development `npm run dev:keys -w server/api`
# writes apps/web/.env.local; in production they come from the environment.

# The account API as this server reaches it (a private address in production).
API_INTERNAL_URL=http://127.0.0.1:8787

# 32 random bytes, base64: encrypts the session cookie. Changing it signs
# everyone out. Generate one with: openssl rand -base64 32
WEB_SESSION_SECRET=

# Optional: where the Windows installer is published, shown on the overview.
# DOWNLOAD_URL_WINDOWS=https://downloads.example.com/ApexyVPN-setup.exe
