# The web dashboard (apps/web) in production. generate.sh copies this to
# web.env with the secret filled in.
#
# Lines starting with "# NAME=" are optional.

NODE_ENV=production
# The API over the stack's private network (compose.yaml also sets it).
API_INTERNAL_URL=http://api:8787
# Encrypts the session cookie (generated). Changing it signs everyone out.
WEB_SESSION_SECRET=
# The published Windows installer, shown on the overview.
# DOWNLOAD_URL_WINDOWS=https://downloads.example.com/ApexyVPN-setup.exe
