# The web stack (deploy/app/compose.yaml): names, tunnel and images.
# generate.sh copies this to stack.env.

# Public names. In the Cloudflare Tunnel both point at HTTP caddy:80.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel: the token
# (the long string after --token in the install command).
TUNNEL_TOKEN=

# Which images run: local/…:dev are built on the server (stack.sh … up --build);
# a release built by CI is APEXY_REGISTRY=ghcr.io/<github owner>, APEXY_VERSION=v1.0.0.
APEXY_REGISTRY=local
APEXY_VERSION=dev
