# Building the release Windows installer (docs/DEPLOYMENT.md, Desktop).
# generate.sh fills APEXY_RELAY_KEYS from the API's RELAY_SIGNING_SEED;
# copy the generated file to the Windows build machine, add the signing
# certificate, then:
#   . .\scripts\load-env.ps1 env\production\desktop-build.env
#   npm run release -w apps/desktop

# Everything below is required.
APEXY_RELEASE=1
# Built into the service and the app.
APEXY_API_URL=https://api.example.com
# Keys that may sign the server list: "id:base64 public key[,id:key]".
APEXY_RELAY_KEYS=

# Code signing: a certificate in the Windows store (EV tokens work this way)…
APEXY_SIGN_THUMBPRINT=
# …or a .pfx file with its password instead of the thumbprint.
# APEXY_SIGN_PFX=C:\certs\apexy.pfx
# APEXY_SIGN_PFX_PASSWORD=
# APEXY_SIGN_TIMESTAMP_URL=http://timestamp.digicert.com
