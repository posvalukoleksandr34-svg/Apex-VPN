# A VPN node's agent (apexy-node), installed as /etc/apexy/node.env by
# deploy/node/setup.sh (which writes APEXY_NODE_API itself). The node token
# isn't here: it's passed with systemd's LoadCredential from
# /etc/apexy/node-token.
#
# Lines starting with "# NAME=" are optional; the value shown is the default.

APEXY_NODE_API=https://api.example.com
# With no peer set from the API for this long, remove every peer (fail closed).
# APEXY_NODE_MAX_STALE_SECS=900
# APEXY_NODE_HEARTBEAT_SECS=60
# APEXY_NODE_LOG=info
