# The account API (server/api) in production.
#
# Don't edit this template for a deployment: `bash env/generate.sh production
# --domain <your-domain>` copies it to api.env next to it (gitignored, 0600)
# with the secrets filled in. Then replace every <…>, and check with
# `bash env/check.sh production`.
#
# Lines starting with "# NAME=" are optional; the value shown is the default.

# ── Service ─────────────────────────────────────────────────────────────
NODE_ENV=production
# HOST=0.0.0.0
# PORT=8787
PUBLIC_BASE_URL=https://api.example.com
# The web dashboard: Stripe sends web customers back there.
WEB_APP_URL=https://app.example.com
# Caddy and the dashboard reach the API over the stack's private network;
# only their X-Forwarded-For is believed.
TRUST_PROXY=loopback,uniquelocal
# RATE_LIMIT_ENABLED=true

# ── Database (Supabase: session pooler, port 5432, certificate-checked) ──
# The CA certificate goes to env/production/secrets/supabase-ca.crt.
DATABASE_URL=postgres://postgres.<project-ref>:<database-password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-ca.crt

# ── Keys (generated; 32 random bytes each, base64) ───────────────────────
# Signs access tokens. Changing it ends every session.
ACCESS_TOKEN_SEED=
# Signs the server list. Its public half is built into the desktop app
# (APEXY_RELAY_KEYS in desktop-build.env): change only with an app release.
RELAY_SIGNING_SEED=
RELAY_KEY_ID=fleet-1
# Encrypts stored two-step secrets. If lost, those secrets can't be read.
DATA_ENCRYPTION_KEY=

# ── Sessions and the server list ─────────────────────────────────────────
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=60
# RELAY_LIST_TTL_MINUTES=360

# ── VPN nodes ───────────────────────────────────────────────────────────
NODE_PROVISIONING=agent

# ── Email (any SMTP provider: Postmark, SES, Mailgun, Brevo, Resend…) ────
MAIL_TRANSPORT=smtp
# smtps://…:465, or smtp://…:587 with STARTTLS. URL-encode special characters in the password.
SMTP_URL=smtps://<smtp-user>:<smtp-password>@<smtp-host>:465
MAIL_FROM=Apexy VPN <no-reply@example.com>

# ── Stripe (docs/PRODUCTION.md, step 6) ──────────────────────────────────
BILLING_PROVIDER=stripe
# live: live keys only. A staging deployment uses test (generate.sh staging sets it).
STRIPE_MODE=live
# Restricted key rk_live_…: write Customers, Checkout Sessions, Subscriptions,
# Customer portal, Refunds; read Invoices, Prices.
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret (whsec_…), for
# https://api.example.com/v1/billing/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# ── Staff tools ─────────────────────────────────────────────────────────
# Admins need two-step verification (on by default in production).
# ADMIN_REQUIRE_MFA=true

# ── Optional ────────────────────────────────────────────────────────────
# Country and city for the IP check, from a MaxMind GeoLite2-City database.
# GEOIP_PROVIDER=none
# MAXMIND_DB_PATH=/run/secrets/GeoLite2-City.mmdb
# Support-ticket attachments (a volume in the stack).
# UPLOAD_DIR=/data/uploads
