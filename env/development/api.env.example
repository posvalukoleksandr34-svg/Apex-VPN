# The account API on a developer machine. You don't copy this by hand:
# `npm run dev:keys -w server/api` writes server/api/.env.local with fresh
# keys and keeps anything you add (like the Stripe test settings below).

NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# PGlite: PostgreSQL in-process, stored in server/api/.data/dev (one process at a time).
DATABASE_URL=pglite://.data/dev
ACCESS_TOKEN_SEED=
RELAY_SIGNING_SEED=
RELAY_KEY_ID=dev-1
DATA_ENCRYPTION_KEY=
# Devices get addresses from the public WireGuard demo server (never in production).
NODE_PROVISIONING=wireguard-demo
WEB_APP_URL=http://127.0.0.1:3000
TRUST_PROXY=loopback

# Emails are printed in the API's console.
# MAIL_TRANSPORT=console

# Plans activate without payment, unless you try Stripe in test mode:
# BILLING_PROVIDER=stripe
# STRIPE_MODE=test
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…   (printed by: stripe listen --forward-to http://127.0.0.1:8787/v1/billing/webhooks/stripe)
# STRIPE_PRICE_MONTHLY=price_…
# STRIPE_PRICE_ANNUAL=price_…
