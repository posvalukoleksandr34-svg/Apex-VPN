{
  "name": "@apexy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Apexy VPN backend: accounts, devices, fleet, billing, support",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/scripts/migrate.ts",
    "dev:keys": "tsx src/scripts/devKeys.ts",
    "dev:seed": "tsx src/scripts/seedDev.ts",
    "node:add": "tsx src/scripts/addNode.ts",
    "user:role": "tsx src/scripts/userRole.ts",
    "openapi": "tsx src/scripts/openapi.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.11",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "vitest": "^5.0.2"
  }
}
