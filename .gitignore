# Rust
/target/
**/target/

# Node
node_modules/
dist/
.next/
next-env.d.ts
.vite/
coverage/

# Tauri
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/binaries/

# Local secrets and state — never commit
.env
.env.*
!.env.example
*.pem
*.key
/dev-keys/
server/api/.data/
server/api/uploads/

# Production settings and certificates of the web stack (deploy/app)
deploy/app/*.env
deploy/app/secrets/
deploy/app/certs/

# Vendored driver archives (the unpacked, signature-checked SDK is kept)
vendor/*.zip

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Development configuration (generated by npm run dev:keys)
/dev/
